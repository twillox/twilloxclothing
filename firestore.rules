rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Anyone can read products and categories
    match /products/{document=**} {
      allow read: if true;
      allow write: if true; // In production this should be admin only, but since checkout decrements stock from client, we allow it temporarily
    }
    
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /banners/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /coupons/{document=**} {
      allow read: if true; 
      allow write: if request.auth != null;
    }

    // Users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /cart/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /wishlist/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders: anyone can create an order (even guests), admins can manage all
    match /orders/{orderId} {
      allow create: if true; 
      allow read, update: if request.auth != null;
    }
    
    // Notifications
    match /notifications/{notifId} {
      allow read, update: if request.auth != null;
      allow create: if true; 
    }

    // Homepage sections - public read, auth write
    match /homepage_sections/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Global store settings - public read, auth write
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
